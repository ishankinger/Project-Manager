<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="member"
            type="com.example.projectmanager.models.SelectedMembers" />
        <variable
            name="clickListener"
            type="com.example.projectmanager.cards.CardMembersListItemAdapter.CardMembersClickListener"/>
    </data>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="5dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_selected_member_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/profile_image"
            android:src="@drawable/ic_user_place_holder"
            android:visibility="visible"
            app:civ_border_color="@color/black"
            app:civ_border_width="0.5dp"
            tools:visibility="visible" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_add_member"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="0.5dp"
            android:onClick="@{()->clickListener.onClick(member)}"
            android:contentDescription="@string/add"
            android:src="@drawable/baseline_add_24"
            android:visibility="visible"
            app:civ_border_color="@color/dark_orchid"
            app:civ_border_width="4dp"
            tools:visibility="visible" />
    </LinearLayout>
</layout>