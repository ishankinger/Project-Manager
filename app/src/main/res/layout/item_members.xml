<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="member"
            type="com.example.projectmanager.models.User" />
        <variable
            name="clickListener"
            type="com.example.projectmanager.members.MemberListItemAdapter.MembersClickListener"/>
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"/>

        <LinearLayout
            android:id="@+id/memberLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:onClick="@{()->clickListener.onClick(member)}"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_selected_member"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/done_button"
                android:src="@drawable/baseline_done_24"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/memberImage"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:contentDescription="@string/board_image"
                android:src="@drawable/ic_user_place_holder"/>

            <LinearLayout
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/memberName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    tools:text="Member" />

                <TextView
                    android:id="@+id/memberEmailId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Email Id" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"/>

    </LinearLayout>
</layout>