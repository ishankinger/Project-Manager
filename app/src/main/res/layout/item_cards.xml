<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="card"
            type="com.example.projectmanager.models.Card" />
        <variable
            name="clickListener"
            type="com.example.projectmanager.cards.CardListItemAdapter.CardsClickListener"/>
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackground"
        android:elevation="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{()->clickListener.onClick(card)}"
            android:orientation="vertical">

            <View
                android:id="@+id/view_label_color"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:visibility="gone"
                tools:background="@color/dark_orchid"
                tools:visibility="visible"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_card_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:textSize="16sp"
                    android:layout_gravity="start"
                    android:textColor="@color/dark_orchid"
                    tools:text="Card Name" />

                <TextView
                    android:id="@+id/tv_due_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:padding="10dp"
                    android:textSize="12sp"
                    android:textColor="@color/grey"
                    tools:text="Date"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_card_selected_members_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/tv_members_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:padding="10dp"
                android:textColor="@color/dark_orchid"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Members Name"
                tools:visibility="visible"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>