<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".boards.BoardsCreateFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/createBoardImage"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/intro_image"
                    android:background="@drawable/outline_circle"
                    android:src="@drawable/ic_user_place_holder" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/createBoardName"
                        android:layout_width="260dp"
                        android:layout_height="64dp"
                        android:layout_marginLeft="32dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="32dp"
                        android:layout_gravity="center"
                        android:hint="@string/board_name"
                        android:autofillHints="name"
                        android:inputType="textVisiblePassword"
                        android:textSize="16sp"
                        android:shadowColor="@color/dark_orchid"
                        android:textColor="@color/black" />
                </com.google.android.material.textfield.TextInputLayout>



                <Button
                    android:id="@+id/createBoardButton"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/primary_color"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/create_board"
                    android:gravity="center"
                    android:textColor="@color/white"/>


            </LinearLayout>

        </ScrollView>

    </LinearLayout>


</layout>