<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="task"
            type="com.example.projectmanager.models.Task" />
        <variable
            name="clickListener"
            type="com.example.projectmanager.tasks.TaskListItemAdapter.TasksClickListener"/>
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_add_task_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/dark_orchid"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/add_list"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_add_task_list_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:elevation="5dp"
                app:cardCornerRadius="5dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/ib_close_list_name"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/cross"
                        android:padding="10dp"
                        android:src="@drawable/baseline_cancel_24"/>

                    <EditText
                        android:id="@+id/et_task_list_name"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="@string/edit"
                        android:autofillHints="name"
                        android:inputType="text" />

                    <ImageButton
                        android:id="@+id/ib_done_list_name"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/delete"
                        android:padding="10dp"
                        android:src="@drawable/baseline_done_24" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/ll_task_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:background="@color/orchid"
                android:orientation="vertical"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/ll_title_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:background="@color/dark_orchid"
                    android:orientation="horizontal"
                    android:visibility="visible"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_task_list_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:padding="12dp"
                        android:onClick="@{()->clickListener.onClick(task)}"
                        tools:text="Title" />

                    <ImageButton
                        android:id="@+id/ib_edit_list_name"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/edit"
                        android:padding="10dp"
                        android:src="@drawable/baseline_edit_24" />

                    <ImageButton
                        android:id="@+id/ib_delete_list"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/delete"
                        android:padding="10dp"
                        android:src="@drawable/baseline_delete_24" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/dark_orchid"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_edit_task_list_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:elevation="5dp"
                    android:visibility="gone"
                    app:cardCornerRadius="5dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/ib_close_editable_view"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="?attr/selectableItemBackground"
                            android:contentDescription="@string/tasks_image"
                            android:padding="10dp"
                            android:src="@drawable/baseline_cancel_24" />

                        <EditText
                            android:id="@+id/et_edit_task_list_name"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:hint="@string/edit_note"
                            android:autofillHints="name"
                            android:inputType="text" />

                        <ImageButton
                            android:id="@+id/ib_done_edit_list_name"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="?attr/selectableItemBackground"
                            android:contentDescription="@string/tasks_image"
                            android:padding="10dp"
                            android:src="@drawable/baseline_done_24" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_card_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_add_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:elevation="5dp"
                    android:visibility="gone"
                    app:cardCornerRadius="5dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/ib_close_card_name"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="?attr/selectableItemBackground"
                            android:contentDescription="@string/tasks_image"
                            android:padding="10dp"
                            android:src="@drawable/baseline_cancel_24" />

                        <EditText
                            android:id="@+id/et_card_name"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:hint="@string/Name"
                            android:autofillHints="name"
                            android:inputType="text" />

                        <ImageButton
                            android:id="@+id/ib_done_card_name"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="?attr/selectableItemBackground"
                            android:contentDescription="@string/tasks_image"
                            android:padding="10dp"
                            android:src="@drawable/baseline_done_24" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tv_add_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/dark_orchid"
                    android:elevation="5dp"
                    android:textSize="18sp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/add_card"
                    android:textColor="@color/white"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</layout>